{
  "version": 2,
  "buildCommand": "cd ../.. && pnpm --filter @workspace/football-scores run build && mkdir -p artifacts/api-server/.vercel-out && cp -r artifacts/football-scores/dist/* artifacts/api-server/.vercel-out/",
  "outputDirectory": ".vercel-out",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": null,
  "env": {
    "BASE_PATH": "/",
    "NODE_ENV": "production"
  },
  "rewrites": [
    { "source": "/((?!assets).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
